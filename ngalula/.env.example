APP_NAME=Ngalula Wellness Center
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ngalula
DB_USERNAME=postgres
DB_PASSWORD=password

# Broadcasting Configuration (Laravel WebSockets)
BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@ngalula.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Configuration (for WebSockets)
PUSHER_APP_ID=ngalula_app
PUSHER_APP_KEY=ngalula_key
PUSHER_APP_SECRET=ngalula_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Firebase Configuration
FIREBASE_PROJECT_ID=ngalula-wellness
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://ngalula-wellness-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_FILE=

# WhatsApp API Configuration
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Socialite Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

# Filament Configuration
FILAMENT_FILESYSTEM_DISK=public
FILAMENT_HTTP_PATH=/

# Media Library Configuration
MEDIA_LIBRARY_DISK=public
MEDIA_LIBRARY_PATH=media

# Backup Configuration
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=admin@ngalula.com

# Health Check Configuration
HEALTH_CHECK_ENABLED=true

# Security Configuration
CSP_ENABLED=true
HONEYPOT_ENABLED=true

# API Configuration
API_RATE_LIMIT=1000
API_TOKEN_EXPIRE_MINUTES=60

# Mobile App Configuration
MOBILE_APP_VERSION=1.0.0
MOBILE_APP_MIN_VERSION=1.0.0

# Real-time Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=6001

# Notification Configuration
FIREBASE_SERVER_KEY=
FIREBASE_SENDER_ID=
FIREBASE_API_KEY=

# Performance Configuration
TELESCOPE_ENABLED=true
HORIZON_ENABLED=true

# Admin authorization keys for admin registration (comma-separated)
ADMIN_AUTH_KEYS=admin-secret-key-2024,super-admin-key-2024
