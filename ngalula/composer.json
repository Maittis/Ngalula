{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Ngalula Wellness Center - Modern API Application",
    "keywords": ["laravel", "framework", "wellness", "spa", "api"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.9",
        "pusher/pusher-php-server": "^7.0",
        "filament/filament": "^3.0",
        "filament/forms": "^3.0",
        "filament/tables": "^3.0",
        "filament/notifications": "^3.0",
        "filament/spatie-laravel-translatable-plugin": "^3.0",
        "spatie/laravel-permission": "^6.0",
        "kreait/laravel-firebase": "^5.0",
        "twilio/sdk": "^7.0",
        "laravel/socialite": "^5.0",
        "laravel/horizon": "^5.0",
        "laravel/telescope": "^5.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-medialibrary": "^11.0",
        "intervention/image": "^3.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "maatwebsite/excel": "^3.1",
        "spatie/laravel-csp": "^2.0",
        "spatie/laravel-honeypot": "^4.0",
        "spatie/laravel-backup": "^8.0",
        "spatie/laravel-health": "^1.0",
        "spatie/laravel-schedule-monitor": "^3.0",
        "spatie/laravel-ignition": "^2.0",
        "doctrine/dbal": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0",
        "laravel/dusk": "^8.0",
        "brianium/paratest": "^7.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
